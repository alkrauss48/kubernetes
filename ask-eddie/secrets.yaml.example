apiVersion: v1
kind: Secret
metadata:
  name: app
  namespace: ask-eddie
type: Opaque
stringData:
  # php artisan key:generate --show
  appKey:
  # Buys the model inference every answer costs.
  openaiApiKey:
  # The lock on /api, comma-separated. This is the key the Krauss Haus server
  # presents in X-Bar-Key; it must never reach a browser. Leaving it empty
  # closes the API to everybody rather than opening it to anybody.
  barApiKeys:
---
apiVersion: v1
kind: Secret
metadata:
  name: db
  namespace: ask-eddie
type: Opaque
stringData:
  database:
  username:
  password:
