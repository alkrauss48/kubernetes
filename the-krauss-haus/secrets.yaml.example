apiVersion: v1
kind: Secret
metadata:
  name: app
  namespace: the-krauss-haus
type: Opaque
stringData:
  # One of the comma-separated keys in ask-eddie's `barApiKeys` secret. It
  # buys model inference and costs real money, so it lives here on the Node
  # server and never reaches a browser -- the guest posts to /api/bar/ask
  # same-origin and this process adds the X-Bar-Key header.
  #
  # Generate one on the API side with:
  #   php -r 'echo bin2hex(random_bytes(24)), PHP_EOL;'
  #
  # ask-eddie's list is a list so this can be rotated without a window where
  # the bar is shut: add the new key there, change it here, drop the old one.
  barApiKey:
